#!/bin/bash
# extdisk-apfs - reclaim an external disk as one APFS volume on a GUID partition map.
#
# Every disk operation here is a documented diskutil verb. The tool adds the
# identification and the refusals around them, because the destructive step
# takes a disk identifier and identifiers are renumbered on every attach.
#
# This file loads the modules and dispatches. The usage text and each command's
# option parsing are in lib/cli.sh.
#
# Repository: https://github.com/xsyetopz/extdisk-apfs
# License: MIT

set -euo pipefail

VERSION='1.3.0'

# Follow a symlink chain to the real script, so that a link on your PATH, such
# as /opt/homebrew/bin/extdisk-apfs, finds lib and data without EXTDISK_LIB.
# readlink -f would be one call, but the macOS readlink has no -f.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
LIB="${EXTDISK_LIB:-$ROOT/lib}"

for unit in ui diskinfo guard inspect erase verify hosts adopt cli; do
  [ -r "$LIB/$unit.sh" ] || {
    printf 'error: cannot read %s/%s.sh; set EXTDISK_LIB to the lib directory\n' "$LIB" "$unit" >&2
    exit 1
  }
  # shellcheck source=/dev/null
  . "$LIB/$unit.sh"
done

case "${1:-}" in
  list) print_candidates ;;
  show)
    [ -n "${2:-}" ] || die "show needs a disk identifier"
    dk_exists "$2" || die "diskutil does not know '$2'"
    print_layout "$2"
    ;;
  erase)
    shift
    cmd_erase "$@"
    ;;
  verify)
    [ -n "${2:-}" ] || die "verify needs a disk identifier"
    verify_disk "$2"
    ;;
  hosts)
    shift
    cmd_hosts "$@"
    ;;
  host)
    shift
    cmd_host "$@"
    ;;
  unhost)
    shift
    cmd_unhost "$@"
    ;;
  explain)
    [ -n "${2:-}" ] || die "explain needs a catalogue id; run 'extdisk-apfs hosts --all' for the ids"
    [ -z "${3:-}" ] || guard_volume "$3"
    print_host "$2" "${3:-}"
    ;;
  validate) hosts_validate || die "the catalogue has a problem" ;;
  --version | -V) say "extdisk-apfs $VERSION" ;;
  help | --help | -h | '') usage ;;
  *) die "unknown command '$1'; run 'extdisk-apfs' for the usage" ;;
esac
