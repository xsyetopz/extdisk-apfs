#!/bin/bash
# tests/run - the checks that need no external disk, so CI can run them.
#
# Each test asserts on an exit status or on a returned value. None asserts on
# the wording of a message, because the wording is free to change.
#
# The destructive path cannot be tested here: an erase has no safe target on a
# CI runner. Set EXTDISK_TEST_DISK to an external disk identifier to also run
# the dry run against real hardware.

set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/bin/extdisk-apfs"
PASS=0
FAIL=0
SKIP=0

# shellcheck source=../lib/ui.sh
. "$ROOT/lib/ui.sh"
# shellcheck source=../lib/diskinfo.sh
. "$ROOT/lib/diskinfo.sh"
# shellcheck source=../lib/guard.sh
. "$ROOT/lib/guard.sh"
# shellcheck source=../lib/erase.sh
. "$ROOT/lib/erase.sh"
# shellcheck source=../lib/hosts.sh
. "$ROOT/lib/hosts.sh"
# shellcheck source=../lib/adopt.sh
. "$ROOT/lib/adopt.sh"

# A scratch directory for the catalogue fixtures and the shell startup file
# that the env-block tests write. Removed on exit, including on a failure.
TMP="$(mktemp -d "${TMPDIR:-/tmp}/extdisk-tests.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

pass() {
  PASS=$((PASS + 1))
  printf '  ok    %s\n' "$1"
}

fail() {
  FAIL=$((FAIL + 1))
  printf '  FAIL  %s\n' "$1" >&2
  [ -z "${2:-}" ] || printf '        %s\n' "$2" >&2
}

skip() {
  SKIP=$((SKIP + 1))
  printf '  skip  %s (%s)\n' "$1" "$2"
}

# exits_zero <description> <command...>
exits_zero() {
  local desc="$1" out
  shift
  if out="$("$@" 2>&1)"; then
    pass "$desc"
  else
    fail "$desc" "exit $?: $(printf '%s' "$out" | tail -n 1)"
  fi
}

# exits_nonzero <description> <command...>
exits_nonzero() {
  local desc="$1" out
  shift
  if out="$("$@" 2>&1)"; then
    fail "$desc" 'exit 0, so it was accepted'
  else
    pass "$desc"
  fi
}

# equals <description> <expected> <actual>
equals() {
  if [ "$2" = "$3" ]; then
    pass "$1"
  else
    fail "$1" "wanted '$2', got '$3'"
  fi
}

# The disk to read facts from and to be refused. Derived rather than written as
# disk0, because a virtual machine, a CI runner and a Mac with a Fusion Drive
# all number their disks differently, and the boot disk is the one disk every
# machine has.
BOOT_DISK="$(dk_boot_disks | head -n 1)"
BOOT_PART="$(dk_list_get AllDisks "$BOOT_DISK" | grep -v "^$BOOT_DISK\$" | head -n 1)"

printf '\ncommands answer\n'
exits_zero 'help' "$BIN" help
exits_zero 'no argument' "$BIN"
exits_zero 'list' "$BIN" list
exits_zero 'version' "$BIN" --version
equals 'version matches the source' \
  "extdisk-apfs $(sed -n "s/^VERSION='\(.*\)'$/\1/p" "$BIN")" \
  "$("$BIN" --version)"
exits_nonzero 'an unknown command' "$BIN" frobnicate
exits_nonzero 'show without an identifier' "$BIN" show
exits_nonzero 'verify without an identifier' "$BIN" verify

printf '\nerase refuses a bad invocation\n'
exits_nonzero 'no identifier' "$BIN" erase
exits_nonzero '--label without a value' "$BIN" erase "$BOOT_DISK" --label
exits_nonzero 'an unknown option' "$BIN" erase "$BOOT_DISK" --nope
exits_nonzero 'no label' "$BIN" erase "$BOOT_DISK" --dry-run

printf '\nerase refuses a bad target\n'
for target in "$BOOT_DISK" "$BOOT_PART" "/dev/$BOOT_DISK" "$BOOT_DISK/../disk9" \
  "$BOOT_DISK;id" 'disk*' nonsense disk99 ''; do
  exits_nonzero "target '$target'" "$BIN" erase "$target" --label T --dry-run
done

printf '\nguard_label\n'
for bad in '' '.' '..' 'a/b' 'a:b' '-x' ' lead' 'trail ' "$(printf 'a\tb')"; do
  if (guard_label "$bad") >/dev/null 2>&1; then
    fail "label '$bad' is refused" 'guard_label accepted it'
  else
    pass "label '$bad' is refused"
  fi
done
for good in Scratch 'Good Name' DevAudioStore a 'a-b' 'a.b'; do
  if (guard_label "$good") >/dev/null 2>&1; then
    pass "label '$good' is accepted"
  else
    fail "label '$good' is accepted" 'guard_label refused it'
  fi
done

printf '\nshell_quote round-trips\n'
equals 'a plain word' 'abc' "$(eval "$(shell_quote printf '%s' abc)")"
equals 'a space' 'Macintosh HD' "$(eval "$(shell_quote printf '%s' 'Macintosh HD')")"
equals 'an apostrophe' "it's" "$(eval "$(shell_quote printf '%s' "it's")")"
# The literal $HOME is the point of this test: shell_quote has to stop the
# shell from expanding it, so it must not expand here either.
# shellcheck disable=SC2016
equals 'a dollar sign' '$HOME' "$(eval "$(shell_quote printf '%s' '$HOME')")"
equals 'a semicolon' 'a;id' "$(eval "$(shell_quote printf '%s' 'a;id')")"
equals 'two words stay two' 'a|b' "$(eval "$(shell_quote printf '%s|%s' a b)")"

printf '\nhuman_size\n'
equals 'bytes' '512 B' "$(human_size 512)"
equals 'zero' '0 B' "$(human_size 0)"
equals 'no argument' '0 B' "$(human_size)"
equals 'megabytes' '209.7 MB' "$(human_size 209715200)"
equals 'gigabytes' '255.9 GB' "$(human_size 255851024384)"
equals 'terabytes' '2.0 TB' "$(human_size 2000000000000)"

printf '\ndisk facts, read from %s\n' "$BOOT_DISK"
if [ -n "$BOOT_DISK" ]; then
  pass 'the boot volume resolves to a whole disk'
else
  fail 'the boot volume resolves to a whole disk' 'dk_boot_disks was empty'
fi
equals 'the root mount point is on the boot disk' "$(dk_boot_disks)" \
  "$(dk_whole_disks_of /)"
equals 'the boot disk is a whole disk' 'true' "$(dk_get "$BOOT_DISK" WholeDisk)"
if [ -n "$BOOT_PART" ]; then
  equals 'a partition resolves to its whole disk' "$BOOT_DISK" \
    "$(dk_whole_disk_of "$BOOT_PART")"
  equals 'a partition is not a whole disk' 'false' "$(dk_get "$BOOT_PART" WholeDisk)"
else
  skip 'a partition resolves to its whole disk' "$BOOT_DISK has no partitions"
fi
if dk_exists "$BOOT_DISK"; then
  pass "dk_exists finds $BOOT_DISK"
else
  fail "dk_exists finds $BOOT_DISK" 'returned false'
fi
if dk_exists disk99; then
  fail 'dk_exists rejects disk99' 'returned true'
else
  pass 'dk_exists rejects disk99'
fi
equals 'dk_get is empty for an absent key' '' "$(dk_get "$BOOT_DISK" NoSuchKey)"
if [ -n "$(dk_identity "$BOOT_DISK")" ]; then
  pass 'dk_identity fingerprints a disk'
else
  fail 'dk_identity fingerprints a disk' 'empty fingerprint'
fi
equals 'dk_identity is stable across calls' \
  "$(dk_identity "$BOOT_DISK")" "$(dk_identity "$BOOT_DISK")"
for d in $(dk_external_whole_disks); do
  equals "$d is listed as external" 'false' "$(dk_get "$d" Internal)"
done
if in_group "$(id -gn)"; then
  pass 'in_group finds your primary group'
else
  fail 'in_group finds your primary group' 'returned false'
fi
if in_group no-such-group-xyz; then
  fail 'in_group rejects a missing group' 'returned true'
else
  pass 'in_group rejects a missing group'
fi

printf '\nthe shipped catalogue\n'
if (hosts_validate) >/dev/null 2>&1; then
  pass 'data/hosts.tsv passes validation'
else
  fail 'data/hosts.tsv passes validation' "$(hosts_validate 2>&1 | head -n 3)"
fi
equals 'every row has twelve fields' '' \
  "$(awk -F'\t' '!/^#/ && NF > 0 && NF != 12 {print $1}' "$(hosts_file)")"
if [ "$(host_ids | wc -l | tr -d ' ')" -gt 0 ]; then
  pass 'the catalogue has entries'
else
  fail 'the catalogue has entries' 'host_ids was empty'
fi
equals 'an id resolves to one row' 1 "$(hosts_row homebrew-cache | wc -l | tr -d ' ')"
equals 'an unknown id resolves to nothing' '' "$(hosts_row no-such-entry)"
equals 'a field comes back by number' 'HOMEBREW_CACHE' \
  "$(host_field 8 "$(hosts_row homebrew-cache)")"

printf '\nvalidation catches a broken catalogue\n'
# Arrange one fixture per defect, each a copy of a good row with one field
# changed, so a passing validator has to be looking at that field.
fixture_header="$(printf 'id\tcategory\tname\tscope\tdetect\tkind\tsubdir\tsetting\tquery\trevert\tsource\tnote')"
good_row="$(printf 'good-row\tdev\tA good row\tpartial\tcmd:sh\tenv\tgood\tGOOD_VAR\t-\t-\ta source\t-')"
write_fixture() {
  printf '%s\n%s\n%s\n' "$fixture_header" "$good_row" "$1" >"$TMP/hosts.tsv"
}
refuses_fixture() {
  local desc="$1" row="$2"
  write_fixture "$row"
  if (EXTDISK_HOSTS="$TMP/hosts.tsv" hosts_validate) >/dev/null 2>&1; then
    fail "$desc" 'hosts_validate accepted it'
  else
    pass "$desc"
  fi
}
write_fixture "$(printf 'other-row\taudio\tAnother\tfull\talways\tnone\t-\ta reason\t-\t-\ta source\t-')"
if (EXTDISK_HOSTS="$TMP/hosts.tsv" hosts_validate) >/dev/null 2>&1; then
  pass 'a well-formed fixture passes'
else
  fail 'a well-formed fixture passes' "$(EXTDISK_HOSTS="$TMP/hosts.tsv" hosts_validate 2>&1 | head -n 2)"
fi
refuses_fixture 'a duplicate id' "$good_row"
refuses_fixture 'an id that is not kebab-case' \
  "$(printf 'Bad_Id\tdev\tName\tpartial\tcmd:sh\tenv\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an unknown category' \
  "$(printf 'row-two\tgames\tName\tpartial\tcmd:sh\tenv\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an unknown scope' \
  "$(printf 'row-two\tdev\tName\tsome\tcmd:sh\tenv\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an unknown detect form' \
  "$(printf 'row-two\tdev\tName\tpartial\tmaybe\tenv\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an unknown kind' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tmagic\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'a subdir with a slash' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tenv\ta/b\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an empty source' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tenv\tx\tX_VAR\t-\t-\t\t-')"
# An empty field in the middle used to shift every later field by one, because
# tab is an IFS whitespace character and read collapsed the two tabs.
refuses_fixture 'an empty field in the middle' \
  "$(printf 'row-two\tdev\t\tpartial\tcmd:sh\tenv\tx\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an env row with no subdir' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tenv\t-\tX_VAR\t-\t-\tsrc\t-')"
refuses_fixture 'an env setting that is not a variable name' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tenv\tx\tsome words\t-\t-\tsrc\t-')"
refuses_fixture 'a flag row with no %s' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tflag\tx\ttool --path\t-\t-\tsrc\t-')"
refuses_fixture 'a cli row with no query' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tcli\tx\ttool set %%s\t-\ttool unset\tsrc\t-')"
refuses_fixture 'a cli row with no revert' \
  "$(printf 'row-two\tdev\tName\tpartial\tcmd:sh\tcli\tx\ttool set %%s\ttool get\t-\tsrc\t-')"

printf '\nhost_installed\n'
if host_installed always; then pass 'always'; else fail 'always'; fi
if host_installed cmd:sh; then pass 'cmd: a command on the PATH'; else fail 'cmd: a command on the PATH'; fi
if host_installed cmd:no-such-command-xyz; then
  fail 'cmd: a missing command' 'returned true'
else
  pass 'cmd: a missing command'
fi
if host_installed path:/usr/bin; then pass 'path: a directory that exists'; else fail 'path: a directory that exists'; fi
if host_installed path:/no/such/path; then
  fail 'path: a missing path' 'returned true'
else
  pass 'path: a missing path'
fi
mkdir -p "$TMP/glob dir/Thing 1.app"
if host_installed "glob:$TMP/glob dir/Thing*.app"; then
  pass 'glob: a pattern with a space matches'
else
  fail 'glob: a pattern with a space matches' 'returned false'
fi
if host_installed "glob:$TMP/glob dir/Nothing*.app"; then
  fail 'glob: a pattern that matches nothing' 'returned true'
else
  pass 'glob: a pattern that matches nothing'
fi

printf '\nhost_render and cli_argv\n'
equals 'one placeholder' 'tool --path /V/x' "$(host_render 'tool --path %s' /V/x)"
equals 'two placeholders' '/V/x and /V/x' "$(host_render '%s and %s' /V/x)"
equals 'a path with a space' 'tool /V/a b' "$(host_render 'tool %s' '/V/a b')"
equals 'a percent in the path stays literal' 'tool /V/100%' "$(host_render 'tool %s' '/V/100%')"
cli_argv 'npm config set cache=%s' '/V/a b'
equals 'the template becomes four arguments' 4 "${#CLI_ARGV[@]}"
equals 'the path stays in one argument' 'cache=/V/a b' "${CLI_ARGV[3]}"
cli_argv 'tool set %s' '/V/x'
equals 'a lone placeholder is its own argument' '/V/x' "${CLI_ARGV[2]}"

printf '\nthe environment block\n'
ENVF="$TMP/zshenv"
printf 'export EDITOR=vi\n' >"$ENVF"
EXTDISK_ENV_FILE="$ENVF" env_block_write /Volumes/Probe 'A_VAR="/Volumes/Probe/a"' >/dev/null 2>&1
equals 'the line that was there survives' 1 "$(grep -c '^export EDITOR=vi$' "$ENVF")"
equals 'the variable is written' 1 "$(grep -c '^export A_VAR="/Volumes/Probe/a"$' "$ENVF")"
EXTDISK_ENV_FILE="$ENVF" env_block_write /Volumes/Probe 'A_VAR="/Volumes/Probe/a"' >/dev/null 2>&1
equals 'writing twice leaves one block' 1 "$(grep -c '^# >>> extdisk-apfs /Volumes/Probe >>>$' "$ENVF")"
equals 'writing twice leaves one variable' 1 "$(grep -c '^export A_VAR=' "$ENVF")"
EXTDISK_ENV_FILE="$ENVF" env_block_write /Volumes/Other 'B_VAR="/Volumes/Other/b"' >/dev/null 2>&1
equals 'a second volume gets its own block' 2 "$(grep -c '^# >>> extdisk-apfs ' "$ENVF")"
env_block_strip "$ENVF" /Volumes/Probe
equals 'stripping removes that block' 0 "$(grep -c 'extdisk-apfs /Volumes/Probe ' "$ENVF")"
equals 'stripping leaves the other block' 1 "$(grep -c '^export B_VAR=' "$ENVF")"
equals 'stripping leaves the unrelated line' 1 "$(grep -c '^export EDITOR=vi$' "$ENVF")"
equals 'the backup keeps the original' 1 \
  "$(cat "$ENVF".extdisk-backup.* 2>/dev/null | grep -c '^export EDITOR=vi$')"

# A volume name is user input, and the block is sourced by every new shell.
# env_pair is the function host_volume builds its lines with, and a real shell
# sources the result, so an expansion or a command substitution shows up here.
# shellcheck disable=SC2016  # not expanding is the point: this is a volume name
HOSTILE='/Volumes/My Disk $HOME`id`/x'
ENVF_H="$TMP/zshenv-hostile"
: >"$ENVF_H"
EXTDISK_ENV_FILE="$ENVF_H" env_block_write /Volumes/Hostile \
  "$(env_pair C_VAR "$HOSTILE")" >/dev/null 2>&1
equals 'a value with a dollar and a backtick is sourced literally' "$HOSTILE" \
  "$(/bin/bash -c '. "$1"; printf "%s" "$C_VAR"' _ "$ENVF_H")"

# A hand-edited file can lose an end marker. Skipping from the start marker to
# a marker that is not there would delete every line after it.
ENVF_U="$TMP/zshenv-unbalanced"
{
  printf 'export KEEP=1\n'
  env_marker_start /Volumes/Probe
  printf 'export INSIDE=2\n'
} >"$ENVF_U"
if (env_block_strip "$ENVF_U" /Volumes/Probe) >/dev/null 2>&1; then
  fail 'an unbalanced marker pair is refused' 'env_block_strip returned zero'
else
  pass 'an unbalanced marker pair is refused'
fi
equals 'the unbalanced file keeps all three lines' 3 "$(grep -c '' "$ENVF_U")"

printf '\nthe host commands\n'
exits_zero 'hosts' "$BIN" hosts
exits_zero 'hosts --all' "$BIN" hosts --all
exits_zero 'validate' "$BIN" validate
exits_zero 'explain a known id' "$BIN" explain homebrew-cache
exits_nonzero 'explain an unknown id' "$BIN" explain no-such-entry
exits_nonzero 'explain with no id' "$BIN" explain
exits_nonzero 'hosts with an unknown option' "$BIN" hosts --nope
exits_nonzero 'hosts with two volumes' "$BIN" hosts /Volumes/a /Volumes/b
exits_nonzero 'host with no volume' "$BIN" host
exits_nonzero 'host on a relative path' "$BIN" host relative/path --dry-run
exits_nonzero 'host on the boot volume' "$BIN" host / --dry-run
exits_nonzero 'host on a missing path' "$BIN" host /no/such/volume --dry-run
exits_nonzero 'host with an unknown id' "$BIN" host / --only no-such-entry --dry-run
exits_nonzero 'host with --only and no value' "$BIN" host / --only
exits_nonzero 'unhost with no volume' "$BIN" unhost
exits_nonzero 'unhost on the boot volume' "$BIN" unhost / --dry-run

printf '\nguard_target against hardware\n'
if [ -n "${EXTDISK_TEST_DISK:-}" ]; then
  exits_zero "$EXTDISK_TEST_DISK passes the refusals" \
    "$BIN" erase "$EXTDISK_TEST_DISK" --label TestLabel --dry-run
  if (guard_unchanged "$EXTDISK_TEST_DISK" deadbeef) >/dev/null 2>&1; then
    fail 'a changed fingerprint is refused' 'guard_unchanged accepted it'
  else
    pass 'a changed fingerprint is refused'
  fi
  if (guard_unchanged "$EXTDISK_TEST_DISK" "$(dk_identity "$EXTDISK_TEST_DISK")") >/dev/null 2>&1; then
    pass 'an unchanged fingerprint is accepted'
  else
    fail 'an unchanged fingerprint is accepted' 'guard_unchanged refused it'
  fi
else
  skip 'the accepting path' 'set EXTDISK_TEST_DISK to an external disk'
fi

printf '\n%s passed, %s failed, %s skipped\n' "$PASS" "$FAIL" "$SKIP"
[ "$FAIL" -eq 0 ]
